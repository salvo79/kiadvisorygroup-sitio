# kiadvisorygroup.com · agentes de IA
# - Markdown cuando el cliente lo pide con «Accept: text/markdown» (cada página tiene su .md, ver _herramientas/agentes.py)
# - Encabezados Link (RFC 8288) hacia llms.txt, la versión Markdown y el sitemap
AddType "text/markdown; charset=utf-8" .md
AddType "text/plain; charset=utf-8" .txt

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1index.md -f
    RewriteRule ^(.*/)?$ /$1index.md [L]
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{DOCUMENT_ROOT}/$1.md -f
    RewriteRule ^(.+)\.html$ /$1.md [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|md)$">
        Header append Vary "Accept"
        Header add Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\""
    </FilesMatch>
    <FilesMatch "^index\.html$">
        Header add Link "<index.md>; rel=\"alternate\"; type=\"text/markdown\""
        Header add Link "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
    </FilesMatch>
</IfModule>
